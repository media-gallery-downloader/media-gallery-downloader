# Git
.git
.gitignore
.gitattributes

# IDE and editors
.idea
.vscode
*.swp
*.swo
*~

# Documentation
README.md
LICENSE
CHANGELOG.md
*.md
docs/

# Testing
tests/
phpunit.xml
.phpunit.result.cache
coverage/

# Development files
.env
.env.local
.env.*.local
docker-compose.override.yml

# Node/Deno (assets built in separate stage)
node_modules/

# Laravel generated files (will be created at runtime)
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Keep .gitkeep files
!storage/logs/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep
!storage/framework/views/.gitkeep

# Local installs, builds and app data. CI builds from a clean checkout, so
# published images never contain these; ignoring them keeps local builds the
# same and keeps local databases, media, cookies and keys out of images.
vendor/
public/build/
public/hot
public/storage
storage/app/*
!storage/app/.gitignore
!storage/app/data/.gitignore
storage/caddy/*
!storage/caddy/.gitignore
storage/framework/testing/*
!storage/framework/testing/.gitignore

# OS files
.DS_Store
Thumbs.db

# Build artifacts
*.log
npm-debug.log*

# Security - never include these
*.pem
*.key
*.crt
cookies.txt
